# --- API ---
PORT=3000
NODE_ENV=development
# Comma-separated list of allowed browser origins
FRONTEND_URL=http://localhost:5173
# REQUIRED. Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me

# --- Database ---
# Option A (hosted, e.g. Neon): set DATABASE_URL and ignore the DB_* variables
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# Option B (local / docker compose)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=lms_db
DB_SSL=false
# true = auto-create tables from entities (dev only). false = run migrations on boot.
DB_SYNCHRONIZE=false
